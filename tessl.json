{
  "name": "ws-01a1639215b37585bbb0f7c3b960423f/tessl-carnival",
  "mode": "managed",
  "dependencies": {
    "tessl-labs/factory-setup": {
      "version": "0.13.0"
    }
  },
  "agents": [
    "claude-code",
    "cursor",
    "codex"
  ],
  "actions": {
    "implement-github-issue": {
      "skill": "tessl-labs/factory#implement-github-issue",
      "environment": "tessl-carnival-factory",
      "agent": "claude",
      "model": "claude-opus-5-5",
      "tags": [
        "delivery"
      ],
      "description": "Ship a labelled GitHub issue as one pull request"
    },
    "shepherd": {
      "skill": "tessl-labs/factory#shepherd",
      "environment": "tessl-carnival-factory",
      "agent": "claude",
      "model": "claude-opus-5-5",
      "tags": [
        "delivery"
      ],
      "description": "Answer reviews and fix checks on Tessl's pull requests"
    },
    "follow-ticket-changes": {
      "skill": "tessl-labs/factory#follow-ticket-changes",
      "environment": "tessl-carnival-factory",
      "agent": "codex",
      "model": "gpt-6-luna",
      "tags": [
        "bookkeeping"
      ],
      "description": "Keep Tessl's runs and pull requests in step with what people do to issues"
    },
    "doc-gardening": {
      "skill": "file:tessl-factory#doc-gardening",
      "environment": "tessl-carnival-factory",
      "agent": "claude",
      "model": "claude-opus-5-5",
      "tags": [
        "maintenance"
      ],
      "description": "File one issue per stale README, AGENTS.md, game README or skill"
    }
  },
  "triggers": {
    "github-issue-labelled": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": {
          "in": [
            14827655,
            295179765
          ]
        },
        "event.issue.state": "open"
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "implement-github-issue"
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1429704247,
        "event.pull_request.state": "open",
        "event.sender.id": {
          "in": [
            14827655,
            325629464
          ]
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1429704247,
        "event.pull_request.state": "open",
        "event.sender.id": 14827655
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.issue.state": "open",
        "event.sender.id": 14827655
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-failed": {
      "on": [
        "github:check_run.completed"
      ],
      "when": {
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.pull_requests.0.head.repo.id": 1429704247,
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_run.conclusion": {
          "in": [
            "failure",
            "timed_out",
            "startup_failure",
            "action_required"
          ]
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_run.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-passed": {
      "on": [
        "github:check_suite.completed"
      ],
      "when": {
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        },
        "event.check_suite.pull_requests.0.head.repo.id": 1429704247,
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.conclusion": "success"
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_suite.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "follow-ticket-changes-github-taken-back": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": 14827655
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back"
        }
      }
    },
    "follow-ticket-changes-github-ended": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": 14827655
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended"
        }
      }
    },
    "follow-ticket-changes-github-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": 14827655
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied"
        }
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.sender.id": 14827655,
        "event.pull_request.head.repo.id": 1429704247
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed"
        }
      }
    }
  },
  "schedules": {
    "doc-gardening-weekly": {
      "cron": "0 7 * * 1",
      "timezone": "Europe/London",
      "description": "Every Monday at 07:00 London time, check the docs against the code",
      "action": "doc-gardening"
    }
  }
}
